[Unit]
Description=Remon monitoring server
Documentation=https://github.com/adnanjpg/remon-server
# The collectors, the SMART poller and the notification channels all want a
# resolvable network before they start reporting failures.
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/local/bin/remon-server --config-dir /etc/remon --data-dir /var/lib/remon

# Always, not on-failure. A monitoring agent that exits cleanly has still
# stopped monitoring, and `on-failure` would leave it down — including after
# someone kills its pid from the process list, which is an easy mistake to
# make against your own agent. Stopping it for real goes through
# `systemctl stop`, which systemd does not undo.
Restart=always
RestartSec=5s

# No start-rate limit. The default (5 starts in 10s, then failed state) turns
# a transient problem — a full disk, a database still on a mounting volume —
# into monitoring that is permanently off and silent about it. Retrying every
# five seconds forever costs log lines and recovers on its own when the
# underlying problem clears; `remon-server doctor` diagnoses the rest.
StartLimitIntervalSec=0
# SIGTERM drains the SSE streams and records a clean shutdown, which the next
# boot reads to tell a restart apart from a crash. Give it room to finish.
KillSignal=SIGTERM
TimeoutStopSec=30s

# Runs as root deliberately. Restarting units, killing processes and reading
# SMART data are the product, and none of them work from an unprivileged
# account — so User=/DynamicUser= are not available here, and NoNewPrivileges
# would break probe scripts that legitimately escalate. What remains are the
# restrictions that cost nothing for this workload:
ProtectHome=read-only
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true

# Creates and owns /var/lib/remon. Root-only: the database holds device token
# hashes, the JWT secret and the VAPID keypair.
StateDirectory=remon
StateDirectoryMode=0700

# The pairing code and the getting-started block are written to stdout, so
# they land in the journal: journalctl -fu remon-server
StandardOutput=journal
StandardError=journal

# A metrics database, a process table walk and a handful of long-lived SSE
# streams. The ceiling catches a runaway; it is not a sizing of the workload.
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
