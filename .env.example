# Runtime environment: development (default) or production
RUN_ENV=development

# Override any config value with REMON__ prefix (double underscore for nesting):

# Server
# REMON__SERVER__PORT=8080
# REMON__SERVER__HOST=0.0.0.0

# Auth secrets (REQUIRED in production)
# REMON__AUTH__JWT_SECRET=change-me-in-production

# Token TTLs (optional — defaults shown)
# REMON__AUTH__ACCESS_TOKEN_TTL_SECS=3600
# REMON__AUTH__REFRESH_TOKEN_TTL_SECS=2592000
# REMON__AUTH__PAIRING_CODE_TTL_SECS=300

# Notification credentials (sensitive — set via env in production)
# REMON__NOTIFICATIONS__FCM__SERVICE_ACCOUNT_PATH=/secrets/fcm.json
# REMON__NOTIFICATIONS__TELEGRAM__BOT_TOKEN=...
# REMON__NOTIFICATIONS__NTFY__TOKEN=...
# REMON__NOTIFICATIONS__WEBHOOK__SECRET=...

# CORS
# REMON__CORS__ALLOW_ANY_ORIGIN=false
# REMON__CORS__ALLOWED_ORIGINS=https://app.example.com

# Docker
# REMON__DOCKER__SOCKET_PATH=/run/podman/podman.sock
# REMON__DOCKER__EXEC_ENABLED=true

# Logging
# REMON__LOGGING__LEVEL=info
# REMON__LOGGING__FORMAT=compact   # compact | pretty | json
