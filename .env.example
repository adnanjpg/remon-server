# Environment Configuration Example for remon-server
# Copy this file to .env and update with your actual values

# Runtime Environment (development, production, staging)
# This determines which config/<env>.toml file to load
RUN_ENV=development

# You can override any config value using environment variables with REMON__ prefix
# Examples:

# Server Configuration
# REMON__SERVER__PORT=9000
# REMON__SERVER__HOST=0.0.0.0

# Database Configuration
# REMON__DATABASE__PATH=./db/custom.sqlite3
# REMON__DATABASE__MAX_CONNECTIONS=5

# Authentication (IMPORTANT: Change this in production!)
# REMON__AUTH__JWT_SECRET=your-super-secret-key-here

# Monitoring
# REMON__MONITORING__UPDATE_INTERVAL_MS=10000
# REMON__MONITORING__ENABLE_NOTIFICATIONS=true

# gRPC
# REMON__GRPC__ADDRESS=127.0.0.1:50051
# REMON__GRPC__ENABLE_REFLECTION=false

# Logging
# REMON__LOGGING__LEVEL=info
# REMON__LOGGING__FORMAT=json

# Firebase Cloud Messaging
GOOGLE_APPLICATION_CREDENTIALS="./.remon-mobile-fcm-creds.json"
# REMON__FCM__CREDENTIALS_PATH="./.remon-mobile-fcm-creds.json"
