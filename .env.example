# Example environment file. Copy to `.env` for local development:
#   cp .env.example .env
#
# NOTE: Runtime configuration lives in config/*.toml and REMON__* environment
# variables (see CONFIG.md) — NOT here. The only value below is for the sqlx
# CLI / compile-time query checks, which need a database URL to connect to.

# Used by `cargo sqlx` (offline cache prep, migrations) and the sqlx macros.
DATABASE_URL=sqlite:./dev.db
