meta {
  name: Update Channel
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/notifications/channels/{{channel_id}}
  body: json
  auth: bearer
}

body:json {
  {
    "name": "my-telegram",
    "enabled": true,
    "config": {
      "bot_token": "...",
      "chat_id": "..."
    },
    "min_severity": "warn"
  }
}

auth:bearer {
  token: {{jwt_token}}
}

docs {
  Replace channel config. All fields required (full replacement, not patch).
}
