meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/login
  body: json
  auth: none
}

body:json {
  {
    "device_id": "{{device_id}}",
    "otp": "123456"
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.token) {
    bru.setEnvVar("jwt_token", body.token);
  }
}

docs {
  Login with device ID and TOTP code.
  Returns a JWT token that will be automatically saved to environment.

  Steps:
  1. First call "Get OTP QR" to generate QR code
  2. Scan QR code with authenticator app (Google Authenticator, Authy, etc.)
  3. Use the 6-digit code from authenticator app as OTP
}
