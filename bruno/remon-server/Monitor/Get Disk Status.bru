meta {
  name: Get Disk Status
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/get-disk-status?start_time={{start_time}}&end_time={{end_time}}
  body: none
  auth: bearer
}

params:query {
  start_time: 0
  end_time: 9999999999
}

auth:bearer {
  token: {{jwt_token}}
}

docs {
  Get disk usage statistics between specified timestamps.
  Returns disk usage frames with available space per disk.

  Parameters:
  - start_time: Unix timestamp (seconds)
  - end_time: Unix timestamp (seconds)
}
