meta {
  name: Get App Logs
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/logs
  body: none
  auth: bearer
}

params:query {
  page: 1
  page_size: 50
  ~start_time: 0
  ~end_time: 9999999999999
  ~include_app_ids: app1,app2
  ~order_by: Time
  ~order_by_direction: Desc
  ~filter_by_word: error
  ~levels: Info,Error,Warn
}

auth:bearer {
  token: {{jwt_token}}
}

docs {
  Get application logs with filtering and pagination.

  Required Parameters:
  - page: Page number (default: 1)
  - page_size: Number of logs per page (default: 10)

  Optional Parameters:
  - start_time: Unix timestamp in milliseconds
  - end_time: Unix timestamp in milliseconds
  - include_app_ids: Comma-separated list of app IDs to include
  - order_by: Sort field (Time, AppId, Log)
  - order_by_direction: Sort direction (Asc, Desc)
  - filter_by_word: Search text in log messages
  - levels: Comma-separated log levels (Trace, Debug, Info, Warn, Error)

  Uncomment parameters (remove ~) to use them.
}
