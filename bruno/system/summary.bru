meta {
  name: Summary
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/summary
  body: none
  auth: bearer
}

auth:bearer {
  token: {{jwt_token}}
}

docs {
  One-call host overview for multi-server clients. A fleet view polls this
  once per daemon to render a server card without fanning out to
  /system/info + /metrics/* + /alerts/state.

  Live-gauge fields are null until the first collector tick lands.

  Response shape:
    {
      "server_name": "...",         // operator-set display name
      "hostname": "...",
      "os": "...",
      "version": "0.8.3",           // remon-server build version
      "uptime_secs": 12345,
      "stats_timestamp": 1700000000,  // tick the gauges were read from
      "cpu_usage_percent": 12.3,
      "memory_used_bytes": 4000000000,
      "memory_total_bytes": 8000000000,
      "disk_max_used_percent": 90.0,  // fullest mount
      "disk_max_mount": "/data",
      "alerts_pending": 0,
      "alerts_firing": 0
    }
}
