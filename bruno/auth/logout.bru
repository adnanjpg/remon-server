meta {
  name: Logout
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/auth/logout
  body: none
  auth: bearer
}

auth:bearer {
  token: {{jwt_token}}
}

docs {
  Revoke the current access token. Only this jti is removed from `sessions`;
  any other live sessions for the same device (other clients) keep working.

  Response: 204 No Content

  Failures:
    401 UNAUTHORIZED   → no Bearer header
    401 INVALID_TOKEN  → token already revoked, expired, or signature bad

  After this call the same access_token will be rejected by every protected
  endpoint. The refresh_token still in the Bruno env will also be invalidated
  the next time it's used (refresh rotation wipes all device sessions).
}
