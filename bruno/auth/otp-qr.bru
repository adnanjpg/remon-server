meta {
  name: Get OTP QR (Legacy)
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/auth/otp/qr
  body: json
  auth: none
}

body:json {
  {
    "device_id": "{{device_id}}"
  }
}

docs {
  [DEPRECATED] Generate a QR code for TOTP authentication setup.
  
  Use the new pairing flow instead:
  1. POST /auth/pair/initiate
  2. POST /auth/pair/complete
  3. POST /auth/login
  
  This endpoint is kept for backward compatibility.
}
