meta {
  name: Login
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "device_id": "{{device_id}}",
    "device_token": "{{device_token}}"
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.access_token) {
    bru.setEnvVar("jwt_token", body.access_token);
    bru.setEnvVar("refresh_token", body.refresh_token);
  }
}

docs {
  Login with device credentials obtained from pairing.
  
  Request:
  - device_id: UUID from pair complete response
  - device_token: 64-char hex token from pair complete response
  
  Response:
  - access_token: Short-lived JWT for API requests (1 hour)
  - refresh_token: Long-lived JWT for token refresh (30 days)
  - expires_in: Access token TTL in seconds
  
  The access_token is automatically saved as jwt_token for other requests.
}
