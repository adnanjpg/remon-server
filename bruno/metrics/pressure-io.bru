meta {
  name: Pressure I/O (PSI)
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/metrics/pressure/io?start={{metrics_start}}&end={{metrics_end}}&resolution={{metrics_resolution}}&limit={{metrics_limit}}
  body: none
  auth: bearer
}

params:query {
  ~start: {{metrics_start}}
  ~end: {{metrics_end}}
  ~resolution: {{metrics_resolution}}
  ~limit: {{metrics_limit}}
}

auth:bearer {
  token: {{jwt_token}}
}

docs {
  PSI block-I/O pressure — fraction of time tasks waited on disk I/O.
  Both `some` and `full` lines are reported.

  Correlate with `metrics_cpu.iowait_percent` and the per-mount
  `read_bytes_per_sec` / `write_bytes_per_sec` to localize which volume
  is the source of saturation.
}
