meta {
  name: Memory History
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/metrics/memory?start={{metrics_start}}&end={{metrics_end}}&resolution={{metrics_resolution}}&limit={{metrics_limit}}
  body: none
  auth: bearer
}

params:query {
  ~start: {{metrics_start}}
  ~end: {{metrics_end}}
  ~resolution: {{metrics_resolution}}
  ~limit: {{metrics_limit}}
}

auth:bearer {
  token: {{jwt_token}}
}

docs {
  Host memory history. Same query semantics as /metrics/cpu.

  Each point: { timestamp, used_bytes, available_bytes, cached_bytes,
                swap_used_bytes }.

  `total_bytes` is intentionally not on the time-series — it's stored once
  per host on the `hosts` row (`total_memory_bytes`).
}
