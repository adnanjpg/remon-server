meta {
  name: Disk History
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/metrics/disk?start={{metrics_start}}&end={{metrics_end}}&resolution={{metrics_resolution}}&limit={{metrics_limit}}
  body: none
  auth: bearer
}

params:query {
  ~start: {{metrics_start}}
  ~end: {{metrics_end}}
  ~resolution: {{metrics_resolution}}
  ~limit: {{metrics_limit}}
}

auth:bearer {
  token: {{jwt_token}}
}

docs {
  Disk history per mount point. Points are flat — one row per
  (timestamp, mount_point) pair. Group client-side by `mount_point` to
  get per-volume series.

  Order: (timestamp ASC, mount_point ASC). A machine with 3 mounts and
  a 1h `raw` window will return up to 3 × 1800 = 5400 points (capped by
  `limit`, default 1000).
}
