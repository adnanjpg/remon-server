meta {
  name: CPU History
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/metrics/cpu?start={{metrics_start}}&end={{metrics_end}}&resolution={{metrics_resolution}}&limit={{metrics_limit}}
  body: none
  auth: bearer
}

params:query {
  ~start: {{metrics_start}}
  ~end: {{metrics_end}}
  ~resolution: {{metrics_resolution}}
  ~limit: {{metrics_limit}}
}

auth:bearer {
  token: {{jwt_token}}
}

docs {
  Host-level CPU history. Points are sorted by `timestamp` ascending.

  Query (all optional):
    start       — unix epoch (s); default: end - 3600
    end         — unix epoch (s); default: now
    resolution  — 'raw'|'1m'|'5m'|'1h'; default: auto from span:
                    ≤2h  → raw  (collector cadence, ~2s)
                    ≤1d  → 1m
                    ≤7d  → 5m
                    >7d  → 1h
    limit       — max points; default 1000, hard cap 5000

  Response:
    {
      "host_id": 1,
      "resolution": "raw",
      "points": [
        { "timestamp", "usage_percent", "load_1m", "load_5m", "load_15m" }, ...
      ]
    }

  Errors:
    400 BAD_REQUEST  — end < start, or unknown `resolution` value
}
