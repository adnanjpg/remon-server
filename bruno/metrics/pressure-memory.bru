meta {
  name: Pressure Memory (PSI)
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/metrics/pressure/memory?start={{metrics_start}}&end={{metrics_end}}&resolution={{metrics_resolution}}&limit={{metrics_limit}}
  body: none
  auth: bearer
}

params:query {
  ~start: {{metrics_start}}
  ~end: {{metrics_end}}
  ~resolution: {{metrics_resolution}}
  ~limit: {{metrics_limit}}
}

auth:bearer {
  token: {{jwt_token}}
}

docs {
  PSI memory pressure — fraction of time tasks were stalled on memory
  reclaim / refault. Unlike CPU PSI, the kernel emits both `some` and
  `full` lines here.

  `full_avg60 > 0` means EVERY runnable task spent some time blocked on
  memory at once, which is the signature of a thrashing host. Treat any
  non-zero `full` averages as actionable.
}
