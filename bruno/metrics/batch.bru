meta {
  name: Batch Metrics
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/metrics/batch?resources=cpu,memory,disk&span=1h
  body: none
  auth: bearer
}

params:query {
  resources: cpu,memory,disk
  span: 1h
  ~start: {{metrics_start}}
  ~end: {{metrics_end}}
  ~resolution: {{metrics_resolution}}
  ~limit: {{metrics_limit}}
}

auth:bearer {
  token: {{jwt_token}}
}

docs {
  Pull many resources in a single request — collapses N per-resource calls
  into one. Worth it on cellular: one radio wake-up, one JWT header, one
  envelope.

  Query:
    resources    — comma-separated, required. Allowed:
                     cpu, cpu_cores, memory, disk, network, components
                   Max 8, no duplicates. Pressure / probe metrics are
                   not in batch (their sub-key shape doesn't fit).
    span         — relative window: '30m','1h','24h','7d', or raw seconds.
                   Mutually exclusive with start/end.
    start, end   — unix epoch (s). If neither span nor start/end given,
                   defaults to last 1h.
    resolution   — 'raw'|'1m'|'5m'|'1h'; default auto from span.
                   cpu_cores ignores this (raw only — no rollup).
    limit        — per-series cap; default 1000, hard cap 5000.

  Response:
    {
      "start": 1715000000,
      "end":   1715003600,
      "resolution": "1m",
      "series": [
        { "resource": "cpu",     "points": [...] },
        { "resource": "memory",  "points": [...] },
        { "resource": "disk",    "points": [...] }
      ]
    }
  `series` order mirrors the request.

  Errors:
    400 BAD_REQUEST  — empty/duplicate/unknown resource, both span and
                       start/end supplied, end < start, unknown resolution.
}
