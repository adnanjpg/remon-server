meta {
  name: List Cron Jobs
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/cron
  body: none
  auth: bearer
}

auth:bearer {
  token: {{jwt_token}}
}

docs {
  List all discoverable cron jobs from the server.

  Sources checked:
    /etc/crontab                  — system crontab
    /etc/cron.d/*                 — drop-in system crontabs
    /var/spool/cron/crontabs/*    — user crontabs (may require root)

  Unreadable files are silently skipped (e.g. permission-restricted user crontabs).
  Returns an empty list on Windows.

  Response: { jobs: [ { schedule, user, command, source } ] }

  Where:
    schedule — "m h dom mon dow" or @shorthand (@daily, @reboot, etc.)
    user     — username (from user crontabs, or the user field in system crontabs)
    command  — the command string
    source   — file the entry was read from
}
