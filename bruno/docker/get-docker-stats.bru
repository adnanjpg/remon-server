meta {
  name: Get Docker Stats
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/docker/stats?start_time={{start_time}}&end_time={{end_time}}
  body: none
  auth: bearer
}

params:query {
  start_time: 0
  end_time: 9999999999999
}

auth:bearer {
  token: {{jwt_token}}
}

docs {
  Get Docker container statistics between specified timestamps.
  Returns stats frames with CPU, memory, and network I/O for each container.

  Parameters:
  - start_time: Unix timestamp in milliseconds
  - end_time: Unix timestamp in milliseconds
}
