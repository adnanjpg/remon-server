meta {
  name: Pause Container
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/docker/containers/{{container_id}}/pause
  body: none
  auth: bearer
}

auth:bearer {
  token: {{jwt_token}}
}

docs {
  Pause a running Docker container.
  
  Parameters:
  - container_id: Docker container ID or name

  ⚠️ Note: Container must be in running state.
}
