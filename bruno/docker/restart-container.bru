meta {
  name: Restart Container
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/docker/containers/{{container_id}}/restart
  body: none
  auth: bearer
}

auth:bearer {
  token: {{jwt_token}}
}

docs {
  Restart a Docker container.

  Parameters:
  - container_id: Docker container ID or name

  ⚠️ Note: Container will be stopped (10s timeout) then started.
}
