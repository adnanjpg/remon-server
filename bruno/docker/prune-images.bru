meta {
  name: Prune Images
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/docker/images/prune
  body: none
  auth: bearer
}

auth:bearer {
  token: {{jwt_token}}
}

docs {
  Remove all unused (dangling) images.
  
  Returns:
  - deleted_count: Number of images deleted
  - deleted_items: List of image IDs/tags
  - space_reclaimed: Bytes freed

  ⚠️ Warning: This will permanently delete all dangling images.
  
  Note: Only removes images not used by any container.
}
