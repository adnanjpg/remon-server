meta {
  name: Get Container
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/docker/containers/{{container_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{jwt_token}}
}

docs {
  Get detailed information about a specific container.
  
  Parameters:
  - container_id: Docker container ID or name
  
  Returns:
  - Container info (ID, name, image, created_at)
  - Container state (running, paused, exit_code, started_at, finished_at)
}
