meta {
  name: Delete Image
  type: http
  seq: 15
}

delete {
  url: {{baseUrl}}/docker/images/{{image_id}}?force={{force}}
  body: none
  auth: bearer
}

params:query {
  force: false
}

auth:bearer {
  token: {{jwt_token}}
}

docs {
  Delete a Docker image.
  
  Parameters:
  - image_id: Docker image ID or name:tag
  - force: If true, force delete even if in use (default: false)

  ⚠️ Warning: This will permanently delete the image.
  
  Note: Use image ID from List Images endpoint, or name:tag format (e.g., nginx:latest)
}
