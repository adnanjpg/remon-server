meta {
  name: Prune Containers
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/docker/containers/prune
  body: none
  auth: bearer
}

auth:bearer {
  token: {{jwt_token}}
}

docs {
  Remove all stopped containers.
  
  Returns:
  - deleted_count: Number of containers deleted
  - deleted_items: List of container IDs
  - space_reclaimed: Bytes freed

  ⚠️ Warning: This will permanently delete all stopped containers.
}
