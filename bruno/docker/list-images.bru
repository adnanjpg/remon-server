meta {
  name: List Images
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/docker/images
  body: none
  auth: bearer
}

auth:bearer {
  token: {{jwt_token}}
}

docs {
  List all Docker images.
  
  Returns for each image:
  - id: Image ID
  - repo_tags: Repository tags (e.g., ["nginx:latest"])
  - repo_digests: Repository digests
  - created: Creation timestamp
  - size: Image size in bytes
  - virtual_size: Virtual size
  - labels: Image labels
}
