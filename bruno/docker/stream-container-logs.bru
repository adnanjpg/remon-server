meta {
  name: Stream Container Logs
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/docker/containers/{{container_id}}/logs/stream
  body: none
  auth: bearer
}

params:query {
  tail: 50
}

auth:bearer {
  token: {{jwt_token}}
}

docs {
  Stream container logs in real-time via Server-Sent Events (SSE).
  
  Parameters:
  - container_id: Container ID or name
  - tail: Number of lines to show initially (default: 50)
  
  Response:
  SSE stream with log lines as data events.
  
  Events:
  - data: Log line content (with timestamp)
  - error: Error messages
  
  Connection stays open until client disconnects.
  
  Usage with curl:
  curl -N -H "Authorization: Bearer <token>" \
    "http://localhost:8080/docker/containers/nginx/logs/stream?tail=50"
}
