meta {
  name: Start Container
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/docker/containers/{{container_id}}/start
  body: none
  auth: bearer
}

auth:bearer {
  token: {{jwt_token}}
}

docs {
  Start a stopped Docker container.

  Parameters:
  - container_id: Docker container ID or name

  ⚠️ Note: Container must be in stopped state.
}
