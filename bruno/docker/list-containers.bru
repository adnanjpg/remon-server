meta {
  name: List Containers
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/docker/containers
  body: none
  auth: bearer
}

auth:bearer {
  token: {{jwt_token}}
}

docs {
  List all Docker containers (running and stopped).
  Returns container details including:
  - Container ID, name, image
  - Current state (running, exited, paused, etc.)
  - Created timestamp
}
