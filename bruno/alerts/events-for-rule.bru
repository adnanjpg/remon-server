meta {
  name: Events for Rule
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/alerts/{{alert_id}}/events?limit={{alert_event_limit}}
  body: none
  auth: bearer
}

params:query {
  ~limit: {{alert_event_limit}}
}

auth:bearer {
  token: {{jwt_token}}
}

docs {
  Audit log scoped to a single rule, newest first. Same shape as
  `/alerts/events`. Use for "history" tabs on a per-rule UI.
}
