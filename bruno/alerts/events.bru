meta {
  name: Recent Alert Events
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/alerts/events?limit={{alert_event_limit}}
  body: none
  auth: bearer
}

params:query {
  ~limit: {{alert_event_limit}}
}

auth:bearer {
  token: {{jwt_token}}
}

docs {
  Cross-rule audit log of fire/resolve transitions, newest first.

  Query:
    limit — default 100, hard cap 1000.

  Response: { events: [AlertEventDto, ...] } where each entry carries
    id, rule_id, label_set, event_type ("fired"|"resolved"),
    severity, occurred_at, metric_value, notified.

  `notified=false` for a fired event means cooldown suppressed the
  fanout (the event is recorded for the audit trail anyway).
  `notified=false` for a resolved event means there were no FCM
  recipients (no devices with fcm_token) — the engine still records
  the recovery.
}
