meta {
  name: Create Alert Rule
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/alerts
  body: json
  auth: bearer
}

body:json {
  {
    "name": "cpu-high",
    "description": "CPU sustained over 80% for 5 minutes",
    "enabled": true,
    "expression": "cpu.usage_percent > 80",
    "severity": "warn",
    "for_duration_secs": 300,
    "eval_interval_secs": 30,
    "cooldown_secs": 900
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.id) {
    bru.setEnvVar("alert_id", body.id);
  }
}

auth:bearer {
  token: {{jwt_token}}
}

docs {
  Create a new alert rule. The evaluator picks it up at the next tick — no restart needed.

  Body shape:
    name              — required, free text
    description       — optional, free text
    enabled           — default true
    expression        — required, see /alerts list docs for grammar
    severity          — required, "warn" | "crit"
    for_duration_secs — default 30. 0 = fire on first violation.
                        Range: 0..86400.
    eval_interval_secs — default 10. Range: 3..3600.
    cooldown_secs     — default 900 (15 min). 0 disables cooldown.
                        Only suppresses fire fanouts; resolved events
                        always fan out.

  Server validates the expression by parsing it; a 400 BAD_REQUEST
  reports the byte offset and message of the first parse error so
  rule editors can highlight the problem inline.

  201 Created → body is the AlertRuleDto with the assigned `id`.
}
