meta {
  name: Kill Process
  type: http
  seq: 2
}

delete {
  url: {{baseUrl}}/processes/{{pid}}
  body: none
  auth: bearer
}



auth:bearer {
  token: {{jwt_token}}
}

docs {
  Kill a process by its PID.

  ⚠️ WARNING: This will forcefully terminate the process.

  Parameters:
  - pid: Process ID to kill

  First call "Get Processes" to find the PID you want to kill.
}
