meta {
  name: Reload Service
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/services/{{service_name}}/reload
  body: none
  auth: bearer
}

auth:bearer {
  token: {{jwt_token}}
}

docs {
  Send a reload signal to a service (systemctl reload — SIGHUP equivalent).
  The service must support in-process config reload; not all services do.

  Returns 501 NOT_SUPPORTED on platforms without reload (Windows SCM).

  Parameters:
    service_name — "nginx" or "nginx.service"
}
