meta {
  name: Restart Service
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/services/{{service_name}}/restart
  body: none
  auth: bearer
}

auth:bearer {
  token: {{jwt_token}}
}

docs {
  Restart a service unit (systemctl restart). Works on both running and stopped units.

  Parameters:
    service_name — "nginx" or "nginx.service"
}
