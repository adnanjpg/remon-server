meta {
  name: Disable Service at Boot
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/services/{{service_name}}/disable
  body: none
  auth: bearer
}

auth:bearer {
  token: {{jwt_token}}
}

docs {
  Disable a service from starting at boot (systemctl disable).

  Parameters:
    service_name — "nginx" or "nginx.service"

  Note: does not stop the currently running service — use /stop for that.
}
