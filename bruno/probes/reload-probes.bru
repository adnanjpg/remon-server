meta {
  name: Reload Probes
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/admin/probes/reload
  body: none
  auth: bearer
}

auth:bearer {
  token: {{jwt_token}}
}

docs {
  Re-scan `probes/` on the server. Diffs the on-disk
  manifest set against the running registry, restarts probes whose
  manifest hash changed, aborts probes whose manifest disappeared,
  starts new ones, leaves unchanged ones alone.

  No file watcher today — call this after a `git pull` or a manual
  manifest edit. Idempotent; safe to call repeatedly.

  Response: { loaded: [...], skipped_disabled: [...],
              skipped_platform: [...],
              failed: [{path, error}] }

  `loaded`           — probes now scheduled and running
  `skipped_disabled` — manifest had `enabled: false`; row exists in DB but no task
  `skipped_platform` — manifest's `platforms` list excludes this host's OS
  `failed`           — manifest didn't validate; see `error` for details
}
