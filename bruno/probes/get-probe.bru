meta {
  name: Get Probe
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/probes/{{probe_name}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{jwt_token}}
}

docs {
  Single probe detail. `last_run` is the run-meta of the most recent
  execution; `last_metrics` is the metric values from that same run.
  History timeseries lives at /metrics/probe/{probe}/{metric}.

  Response: {
    name, description, enabled, schedule, timeout_ms,
    command: ["...", "..."], platforms: [...],
    last_run: { timestamp, duration_ms, exit_code, message, parse_ok },
    last_metrics: [ { name, value, unit?, labels: {…} } ]
  }

  `last_run` is null and `last_metrics` is `[]` until the probe has
  fired once.

  Failures:
    400 BAD_REQUEST  → name has invalid characters
    404 NOT_FOUND    → probe not in registry (manifest never loaded or removed)
}
