meta {
  name: List Probes
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/probes
  body: none
  auth: bearer
}

auth:bearer {
  token: {{jwt_token}}
}

docs {
  List every probe currently loaded into the registry.

  Probes are external scripts defined either by YAML manifests
  (`configs/probes/*.yaml`) or by inline-header scripts (any other file
  with `# @probe key=value` lines at the top). Each row carries:
    - the manifest's declared schedule + timeout
    - timestamp + summary message of the last run (run-meta)
    - last_parse_ok: false signals a contract violation (the script
      didn't produce parseable JSON output) — the most useful field for
      spotting a broken probe.

  Response: { probes: [ { name, description, enabled, schedule, timeout_ms,
                          last_run_at, last_message, last_parse_ok } ] }

  Probe metric values are NOT in this response — they are first-class
  time-series rows in `metrics_probe`. Query them via
  GET /metrics/probe/{probe_name}/{metric_name}.
}
