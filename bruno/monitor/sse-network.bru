meta {
  name: Stream Network Stats (SSE)
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/sse/monitor/network
  body: none
  auth: bearer
}

auth:bearer {
  token: {{jwt_token}}
}

docs {
  Real-time network stats via Server-Sent Events.
  
  ```bash
  curl -N -H "Authorization: Bearer $JWT_TOKEN" \
    "http://localhost:8080/sse/monitor/network"
  ```
}
