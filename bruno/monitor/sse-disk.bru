meta {
  name: Stream Disk Stats (SSE)
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/sse/monitor/disk
  body: none
  auth: bearer
}

auth:bearer {
  token: {{jwt_token}}
}

docs {
  Real-time disk stats via Server-Sent Events.
  
  ```bash
  curl -N -H "Authorization: Bearer $JWT_TOKEN" \
    "http://localhost:8080/sse/monitor/disk"
  ```
}
