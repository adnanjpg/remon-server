meta {
  name: Get Network Status
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/get-network-status
  body: none
  auth: bearer
}

params:query {
  ~start_time: 
  ~end_time: 
}

auth:bearer {
  token: {{jwt_token}}
}

docs {
  Get network I/O statistics per interface.
  
  Parameters (all optional):
  - start_time: Unix timestamp in milliseconds
  - end_time: Unix timestamp in milliseconds
  
  If no params provided, returns the latest frame.
  
  Returns:
  - interface_name: Network interface name (eth0, wlan0...)
  - rx_bytes: Total bytes received (cumulative)
  - tx_bytes: Total bytes transmitted (cumulative)
  - rx_packets: Total packets received
  - tx_packets: Total packets transmitted
  
  Note: Values are cumulative. Calculate delta between frames for rate.
}
